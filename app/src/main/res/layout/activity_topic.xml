<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название темы"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="20dp"/>

        <!-- Теория -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Теория:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#007BFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTheory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Здесь будет теория..."
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#333333"
            android:layout_marginBottom="20dp"/>

        <!-- Пример кода -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💻 Пример кода:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#007BFF"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2D2D2D"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Код..."
                android:textColor="#A9DC76"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"/>
        </HorizontalScrollView>

        <!-- Кнопка "Показать результат" -->
        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Показать результат"
            android:backgroundTint="#28A745"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Результат -->
        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вывод:\n..."
            android:textSize="15sp"
            android:textColor="#000000"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp"/>

        <!-- Аналогия -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Аналогия из жизни:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#007BFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvAnalogy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Аналогия..."
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#555555"
            android:background="#FFF3CD"
            android:padding="12dp"/>

    </LinearLayout>
</ScrollView>